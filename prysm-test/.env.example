# PRYSM Frontend Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL (REQUIRED for production)
# After deploying the backend to Railway/Render, update this with the public URL
VITE_TEST_API_URL=https://your-backend-url.railway.app
VITE_API_URL=https://your-backend-url.railway.app

# TEST_MODE - Set to true to skip payment (for testing)
VITE_TEST_MODE=true

# Google Maps API Key (optional, for future features)
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
